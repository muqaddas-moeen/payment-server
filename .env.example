# Copy this file to `.env` and fill in your Stripe test keys.
# Dashboard: https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Server (local dev only — do NOT set PORT=4242 on Docker/cloud; use 8080 or leave unset)
PORT=4242
HOST=0.0.0.0

# Optional comma-separated origins for CORS (use * for local dev)
CORS_ORIGIN=*
